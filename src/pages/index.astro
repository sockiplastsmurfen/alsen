---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
const profiles = (await getCollection('profiles')).sort((a, b) => a.id.localeCompare(b.id));
const base = import.meta.env.BASE_URL;
---
<Base title="CVs" description="CVs">
  <nav id="nav"><a href={base} class="nav-logo">CV</a>
    <div class="theme-toggle-wrapper"><button type="button" class="theme-toggle" id="themeToggle" role="switch" aria-checked="true" aria-label="Dark mode"></button></div>
  </nav>
  <main class="plain-page">
    <section>
      <div class="section-label">People</div>
      <ul class="people">
        {profiles.map((p) => {
          const user = p.id.split('/')[0];
          return (
            <li>
              <a class="person" href={`${base}${user}/`}>
                {p.data.avatar && <Image src={p.data.avatar} alt="" width={72} height={72} />}
                <strong>{p.data.name}</strong>
                <span>{p.data.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
  <footer><p>CV site</p></footer>
</Base>
