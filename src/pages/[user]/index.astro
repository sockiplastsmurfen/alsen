---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';

export async function getStaticPaths() {
  const profiles = await getCollection('profiles');
  const [experience, education] = await Promise.all([getCollection('experience'), getCollection('education')]);
  const byUser = <T extends { id: string }>(all: T[], user: string) => all.filter((e) => e.id.startsWith(`${user}/`));
  const newest = (a: { data: { start: Date } }, b: { data: { start: Date } }) => b.data.start.getTime() - a.data.start.getTime();
  const known = new Set(profiles.map((p) => p.id.split('/')[0]));
  for (const e of [...experience, ...education]) {
    const user = e.id.split('/')[0];
    if (!known.has(user)) { known.add(user); console.warn(`[alsen] content/${user}/ has no profile.yml; no page generated`); }
  }
  return Promise.all(
    profiles.map(async (p) => {
      const user = p.id.split('/')[0];
      const prep = async (e: any, org: string) => ({ ...e.data, org, Content: (await render(e)).Content });
      const exp = await Promise.all(byUser(experience, user).sort(newest).map((e) => prep(e, e.data.company)));
      const edu = await Promise.all(byUser(education, user).sort(newest).map((e) => prep(e, e.data.school)));
      return { params: { user }, props: { profile: p.data, exp, edu } };
    }),
  );
}
const { profile, exp, edu } = Astro.props;
const base = import.meta.env.BASE_URL;
const initials = profile.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 3).toUpperCase();
---
<Base title={`${profile.name} – CV`} description={profile.summary} accent={profile.accent}>
  <nav id="nav">
    <a href="#" class="nav-logo">{initials}</a>
    <ul class="nav-links" id="navLinks">
      <li><a href="#about">About</a></li>
      {profile.skills.length > 0 && <li><a href="#expertise">Expertise</a></li>}
      {exp.length > 0 && <li><a href="#experience">Experience</a></li>}
      {profile.speaking.length > 0 && <li><a href="#speaking">Speaking</a></li>}
      {profile.projects.length > 0 && <li><a href="#opensource">Open Source</a></li>}
      {edu.length > 0 && <li><a href="#education">Education</a></li>}
      {(profile.email || profile.links.length > 0) && <li><a href="#contact">Contact</a></li>}
      <li><a href={base}>All CVs</a></li>
    </ul>
    <div class="theme-toggle-wrapper"><button type="button" class="theme-toggle" id="themeToggle" role="switch" aria-checked="true" aria-label="Dark mode"></button></div>
    <button class="nav-toggle" id="navToggle" aria-label="Menu"><span></span><span></span><span></span></button>
  </nav>

  <section class="hero" id="hero">
    <div class="hero-image-wrap">
      {profile.avatar
        ? <Image src={profile.avatar} alt={profile.name} width={1600} height={1600} loading="eager" style="width:100%;height:100%;object-fit:cover;object-position:center 35%" />
        : <div class="hero-fallback"></div>}
    </div>
    <div class="hero-content">
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-title">{profile.title}</p>
      {profile.location && <p class="hero-location">{profile.location}</p>}
    </div>
    <div class="scroll-indicator"><div class="scroll-arrow"></div></div>
  </section>

  <section id="about">
    <div class="reveal">
      <div class="section-label">About</div>
      <p class="about-text">{profile.summary}</p>
      {profile.stats.length > 0 && (
        <div class="about-stats">
          {profile.stats.map((s) => <div class="stat"><div class="stat-number">{s.value}</div><div class="stat-label">{s.label}</div></div>)}
        </div>
      )}
    </div>
  </section>

  {profile.skills.length > 0 && (
    <section id="expertise">
      <div class="reveal">
        <div class="section-label">Expertise</div>
        <div class="expertise-grid">
          {profile.skills.map((g) => (
            <div class="expertise-col"><h3>{g.name}</h3><div class="tags">{g.items.map((i) => <span class="tag">{i}</span>)}</div></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {exp.length > 0 && (
    <section id="experience">
      <div class="reveal"><div class="section-label">Experience</div></div>
      <Timeline items={exp} />
      {profile.earlier.length > 0 && (
        <div class="reveal">
          <div class="section-label" style="margin-top:var(--space-lg)">Earlier</div>
          <div class="earlier-roles">
            {profile.earlier.map((e) => <div class="earlier-role"><div class="earlier-role-title">{e.title}</div>{e.meta && <div class="earlier-role-meta">{e.meta}</div>}</div>)}
          </div>
        </div>
      )}
    </section>
  )}

  {profile.speaking.length > 0 && (
    <section id="speaking">
      <div class="reveal"><div class="section-label">Speaking &amp; Conferences</div></div>
      <div class="speaking-grid">
        {profile.speaking.map((s, i) => (
          <div class={`speaking-card reveal${i < 3 ? ' featured' : ''}`}>
            <div class="speaking-venue">{s.event}</div>
            <div class="speaking-location">{s.year}</div>
            <div class="speaking-topic">{s.url ? <a href={s.url}>{s.title}</a> : s.title}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  {profile.projects.length > 0 && (
    <section id="opensource">
      <div class="reveal"><div class="section-label">Open Source &amp; Community</div></div>
      <div class="oss-grid">
        {profile.projects.map((p) => {
          const T = p.url ? 'a' : 'div';
          return (
            <T class="oss-card reveal" {...(p.url ? { href: p.url, target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <div class="oss-card-name">{p.name}</div>
              <div class="oss-card-desc">{p.description}</div>
            </T>
          );
        })}
      </div>
    </section>
  )}

  {edu.length > 0 && (
    <section id="education">
      <div class="reveal">
        <div class="section-label">Education</div>
        <div class="edu-grid">
          {edu.map(({ Content, ...e }) => (
            <div class="edu-card">
              <div class="edu-degree">{e.title}</div>
              <div class="edu-school">{e.org}</div>
              <div class="edu-years">{e.stop ? `${e.start.getUTCFullYear()} – ${e.stop.getUTCFullYear()}` : `${e.start.getUTCFullYear()} – Present`}</div>
              <div class="edu-thesis"><Content /></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {(profile.email || profile.links.length > 0) && <section class="contact" id="contact">
    <div class="reveal">
      <div class="contact-heading">Let's talk.</div>
      {profile.email && <p class="contact-sub"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>}
      {profile.links.length > 0 && (
        <div class="contact-links">
          {profile.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer" class="contact-link">{l.label}</a>)}
        </div>
      )}
    </div>
  </section>}

  <footer><p>© {new Date().getFullYear()} {profile.name}{profile.location && `. ${profile.location}`}.</p></footer>
</Base>
