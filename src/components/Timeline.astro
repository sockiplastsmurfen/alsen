---
import { Image } from 'astro:assets';
interface Item { title: string; org: string; link?: string; start: Date; stop?: Date; location?: string; tags?: string[]; image?: ImageMetadata; Content: any }
interface Props { items: Item[] }
const year = (d: Date) => d.getUTCFullYear();
const when = (i: Item) => {
  const from = year(i.start);
  const to = i.stop ? year(i.stop) : new Date().getUTCFullYear();
  const range = i.stop ? (from === to ? `${from}` : `${from} – ${to}`) : `${from} – Present`;
  const n = to - from;
  return n >= 1 ? `${range} · ${n} year${n === 1 ? '' : 's'}` : range;
};
---
<div class="timeline">
  {Astro.props.items.map(({ Content, ...i }) => (
    <div class="timeline-item reveal">
      <div class="timeline-dot"></div>
      <div class="timeline-years">{when(i)}</div>
      <div class="timeline-role">{i.title}</div>
      <div class="timeline-company">
        {i.link ? <a href={i.link} target="_blank" rel="noopener noreferrer">{i.org}</a> : i.org}{i.location && ` — ${i.location}`}
      </div>
      <div class="timeline-desc"><Content /></div>
      {i.image && <Image src={i.image} alt="" width={480} class="timeline-img" />}
      {i.tags && i.tags.length > 0 && <div class="timeline-stack">{i.tags.map((t) => <span>{t}</span>)}</div>}
    </div>
  ))}
</div>
